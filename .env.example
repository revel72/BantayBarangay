# Copy to .env.local for local dev; set the same names in Vercel for production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=at-least-32-random-characters
# Production database (Turso). Leave unset locally to use local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional, display timezone for report times
REPORT_TIMEZONE=Asia/Manila
# Optional: emergency number on the red Call button (default 911)
NEXT_PUBLIC_EMERGENCY_NUMBER=911
# Optional: your barangay hotline. When set, a second "Call Barangay" button appears.
NEXT_PUBLIC_BARANGAY_NUMBER=
# Optional: barangay name for the button, e.g. San Roque (shows "Call San Roque")
NEXT_PUBLIC_BARANGAY_NAME=
