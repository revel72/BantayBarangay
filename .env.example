# Copy to .env.local for local dev; set the same names in Vercel for production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=at-least-32-random-characters
# Production database (Turso). Leave unset locally to use local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional, display timezone for report times
REPORT_TIMEZONE=Asia/Manila
# Barangay hotline shown on the main Call button. Cavite area code 046 is added automatically
# when you type only the 7 local digits, so 2309641 means (046) 230 9641.
NEXT_PUBLIC_BARANGAY_NUMBER=046 230 9641
# Area code used for 7-digit numbers (default 046 = Cavite)
NEXT_PUBLIC_AREA_CODE=046
# Optional: barangay name on the button, e.g. San Roque (shows "Call San Roque")
NEXT_PUBLIC_BARANGAY_NAME=
# Optional: national emergency number on the second button (default 911)
NEXT_PUBLIC_EMERGENCY_NUMBER=911
